# PostgreSQL (pooled connection string used by the app at runtime)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Direct (non-pooled) connection string used by the Prisma CLI
DIRECT_URL=postgresql://user:password@host/database?sslmode=require

GEMINI_API_KEY=your-primary-gemini-api-key
GEMINI_API_KEY_FALLBACK=your-secondary-gemini-api-key
GEMINI_MODEL=googleai/gemini-3.6-flash
GEMINI_FALLBACK_MODELS=googleai/gemini-flash-lite-latest,googleai/gemini-3.5-flash-lite,googleai/gemini-3.1-flash-lite

# Auth.js — generate with: npx auth secret
AUTH_SECRET=your-auth-secret

# Google OAuth — redirect URI: http://localhost:3000/api/auth/callback/google
# Leave these empty to hide the "Continue with Google" button.
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
